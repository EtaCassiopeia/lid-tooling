{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "lid.source.injection",
  "injectionSelector": "L:source -comment.line, L:source -string",
  "patterns": [
    {
      "include": "#at-spec-citation"
    }
  ],
  "repository": {
    "at-spec-citation": {
      "match": "(@spec)\\s+([A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+(?:\\s*,\\s*[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+)*)",
      "captures": {
        "1": {
          "name": "keyword.control.lid.spec-annotation"
        },
        "2": {
          "patterns": [
            {
              "match": "[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+",
              "name": "entity.name.type.lid.spec-id"
            },
            {
              "match": ",",
              "name": "punctuation.separator.lid"
            }
          ]
        }
      }
    }
  }
}
